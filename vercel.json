{
  "crons": [
    {
      "path": "/api/cron/checkins",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/crm-sync",
      "schedule": "40 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(self), camera=(self)"
        }
      ]
    }
  ]
}
